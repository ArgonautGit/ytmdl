#!/usr/bin/env python3
"""Adds our Android code to the Gradle project `dx build` generates (run by
tools/build-apk).

  tools/patch-gradle-project <gradle project dir> <repo root> <build number>

- app/android/*.kt: the Media3 playback service, the library it offers to
  cars (Browse, with ArtProvider serving the covers), its JNI bridge
  (YtmdlPlayer), the downloads foreground service, the receiver of shared
  links, and a MainActivity replacing the generated one.
- app/android/res: the launcher and notification icons (overriding dx's), and
  what lists the app in Android Auto.
- Media3, pinned to 1.9.x: the newest built against Kotlin 2.0, which the
  generated project compiles with (1.10+ pulls in kotlin-stdlib 2.2).
- The build number (tools/build-number) as the versionCode, which Android
  requires to not go down when an update is installed.
- The manifest: the playback service, in its own ":player" process and
  browsable as a media library (Android Auto), with the cover art provider;
  the downloads service, and the activity handling every configuration
  change, single-task and taking shared text. The Rust side can't survive the
  activity being re-created, or a second one, in one process (see
  MainActivity.kt).

Safe to run again on an already patched project.
"""

import re
import shutil
import sys
from pathlib import Path

MEDIA3 = "1.9.4"

CONFIG_CHANGES = (
    "orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
    "|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc"
)

# "Share" in YouTube Music (or anything sharing a link) lists the app.
SHARE_FILTER = """\
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
"""

# Media3's own controllers find the service by the first action, Android Auto
# and older media browsers by the other.
LIBRARY_ACTIONS = """\
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
"""

SERVICES = """\
        <service android:name="dev.nick.ytmdl.PlaybackService" android:process=":player"
            android:exported="true" android:foregroundServiceType="mediaPlayback">
            <intent-filter>
""" + LIBRARY_ACTIONS + """\
            </intent-filter>
        </service>
        <service android:name="dev.nick.ytmdl.DownloadService"
            android:exported="false" android:foregroundServiceType="dataSync" />
"""

# Cover art for the car and the system's media controls (Browse.kt), in the
# player's process, which runs whenever they are connected.
ART_PROVIDER = """\
        <provider android:name="dev.nick.ytmdl.ArtProvider" android:process=":player"
            android:authorities="${applicationId}.art" android:exported="true" />
"""

# Lists the app in Android Auto.
CAR_APP = """\
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
"""


def main() -> None:
    project, root, build = Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])
    main_dir = project / "app/src/main"
    sources = root / "app/android"

    kotlin = main_dir / "kotlin"
    shutil.copy(sources / "MainActivity.kt", kotlin / "dev/dioxus/main/MainActivity.kt")
    ours = kotlin / "dev/nick/ytmdl"
    ours.mkdir(parents=True, exist_ok=True)
    for name in ("PlaybackService.kt", "Browse.kt", "YtmdlPlayer.kt", "Downloads.kt", "Share.kt"):
        shutil.copy(sources / name, ours / name)
    shutil.copytree(sources / "res", main_dir / "res", dirs_exist_ok=True)

    gradle = project / "app/build.gradle.kts"
    text = gradle.read_text()
    if "androidx.media3" not in text:
        deps = "".join(
            f'    implementation("androidx.media3:{name}:{MEDIA3}")\n' for name in ("media3-exoplayer", "media3-session")
        )
        text, n = re.subn(r"^dependencies \{\n", lambda m: m.group(0) + deps, text, count=1, flags=re.M)
        assert n == 1, "no dependencies block in build.gradle.kts"
    text, n = re.subn(r"versionCode = \d+", f"versionCode = {build}", text)
    assert n == 1, "no versionCode in build.gradle.kts"
    # dx sets the crate version; the build number tells builds apart in App info.
    text, n = re.subn(r'versionName = "([^" ]*)[^"]*"', rf'versionName = "\1 ({build})"', text)
    assert n == 1, "no versionName in build.gradle.kts"
    gradle.write_text(text)

    manifest = main_dir / "AndroidManifest.xml"
    text = manifest.read_text()
    text, n = re.subn(r'android:configChanges="[^"]*"', f'android:configChanges="{CONFIG_CHANGES}"', text)
    assert n == 1, "the activity's configChanges not found"
    if "android:launchMode" not in text:
        text, n = re.subn(r'(android:configChanges="[^"]*")', r'\1 android:launchMode="singleTask"', text)
        assert n == 1
    if "android.intent.action.SEND" not in text:
        launcher = re.search(r"\n *<intent-filter>\s*<action android:name=\"android.intent.action.MAIN\" />.*?</intent-filter>\n", text, re.S)
        assert launcher, "the launcher intent filter not found"
        text = text[: launcher.end()] + SHARE_FILTER + text[launcher.end() :]
    if "PlaybackService" not in text:
        assert text.count("</application>") == 1
        text = text.replace("    </application>", SERVICES + "    </application>")
        assert "PlaybackService" in text, "could not place the services"
    # A project patched before the service was a library service.
    old = '                <action android:name="androidx.media3.session.MediaSessionService" />\n'
    if old in text:
        text = text.replace(old, LIBRARY_ACTIONS)
    assert "android.media.browse.MediaBrowserService" in text, "the playback service's intent filter not found"
    if "ArtProvider" not in text:
        text = text.replace("    </application>", ART_PROVIDER + "    </application>")
        assert "ArtProvider" in text, "could not place the art provider"
    if "com.google.android.gms.car.application" not in text:
        text = text.replace("    </application>", CAR_APP + "    </application>")
        assert "automotive_app_desc" in text, "could not place the Android Auto declaration"
    manifest.write_text(text)


if __name__ == "__main__":
    main()
